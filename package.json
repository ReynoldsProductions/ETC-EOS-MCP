{
  "name": "eos-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that controls an ETC Eos lighting console (Nomad/Puck) over OSC — fire/record cues, set channel levels, drive faders and encoders.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "eos-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "osc": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
