    {
      "_note": "live selection summary — a formatted STRING, not structured data",
      "address": "/eos/out/active/chan",
      "args": [
        { "type": "s", "value": "1  [40] ETC_Fixtures S4_LED_S3_Lustr_X8_Direct @ 37" }
      ]
    },
    {
      "_note": "pushed per-parameter data for the selected channel: [label with value, category, value]",
      "address": "/eos/out/active/wheel/1",
      "args": [
        { "type": "s", "value": "Intens  [40]" },
        { "type": "i", "value": 1 },
