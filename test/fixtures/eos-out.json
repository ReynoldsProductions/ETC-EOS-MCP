        { "type": "s", "value": "Saturation" }, { "type": "f", "value": 0 }, { "type": "f", "value": 0 }, { "type": "f", "value": 100 },
        { "type": "s", "value": "Cooling Fan" }, { "type": "f", "value": 0 }, { "type": "f", "value": -2 }, { "type": "f", "value": -2 },
        { "type": "s", "value": "Shutter Strobe" }, { "type": "f", "value": 0 }, { "type": "f", "value": 0 }, { "type": "f", "value": 255 },
