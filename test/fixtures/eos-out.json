{
  "_comment": [
    "Real OSC output captured from an Eos console (v3.3.9.25) — see docs/eos-osc-findings.md.",
    "Args are stored exactly as the `osc` package delivers them with metadata:true, i.e.",
    "{type, value} wrapped, because that is what a parser has to cope with.",
    "The show file path has been scrubbed; everything else is verbatim.",
    "Regenerate with: EOS_HOST=<ip> node tools/diagnostics/capture.mjs"
  ],
  "messages": [
    {
      "_note": "session handshake — console echoes back the OSC user we claimed",
      "address": "/eos/out/user",
      "args": [{ "type": "i", "value": 99 }]
    },
    {
      "address": "/eos/out/event/state",
      "args": [{ "type": "i", "value": 1 }]
    },
    {
      "address": "/eos/out/ping",
      "args": [{ "type": "s", "value": "probe" }]
    },
    {
      "_note": "eos version, show file version, gel type",
      "address": "/eos/out/get/version",
      "args": [
        { "type": "s", "value": "3.3.9.25" },
        { "type": "s", "value": "3.3.9.2" },
        { "type": "i", "value": 0 }
      ]
    },
    {
      "_note": "path scrubbed — real responses leak a full local filesystem path",
      "address": "/eos/out/get/show/path",
      "args": [{ "type": "s", "value": "/path/to/Example Show.esf3d" }]
    },

    { "address": "/eos/out/get/patch/count", "args": [{ "type": "i", "value": 11 }] },
    { "address": "/eos/out/get/cuelist/count", "args": [{ "type": "i", "value": 1 }] },
    { "address": "/eos/out/get/group/count", "args": [{ "type": "i", "value": 4 }] },
    { "address": "/eos/out/get/sub/count", "args": [{ "type": "i", "value": 0 }] },
    { "address": "/eos/out/get/macro/count", "args": [{ "type": "i", "value": 0 }] },
    { "address": "/eos/out/get/ms/count", "args": [{ "type": "i", "value": 1 }] },
    { "address": "/eos/out/get/cp/count", "args": [{ "type": "i", "value": 1 }] },

    {
      "_note": "cue list 99, NOT 1 — never assume list numbering starts at 1",
      "address": "/eos/out/get/cuelist/99/list/0/13",
      "args": [
        { "type": "i", "value": 0 },
        { "type": "s", "value": "6929F4D5-2FC0-4398-A174-FD04AFC5A8A4" },
        { "type": "s", "value": "" },
        { "type": "s", "value": "Master (U1)" },
        { "type": "s", "value": "Proportional" },
        { "type": "F", "value": false },
        { "type": "F", "value": false },
        { "type": "F", "value": false },
        { "type": "F", "value": false },
        { "type": "T", "value": true },
        { "type": "F", "value": false },
        { "type": "i", "value": -1 },
        { "type": "F", "value": false }
      ]
    },
    {
      "address": "/eos/out/get/cuelist/99/links/list/0/2",
      "args": [
        { "type": "i", "value": 0 },
        { "type": "s", "value": "6929F4D5-2FC0-4398-A174-FD04AFC5A8A4" }
      ]
    },
    {
      "_note": "cue list exists but is empty",
      "address": "/eos/out/get/cue/99/count",
      "args": [{ "type": "i", "value": 0 }]
    },
    {
      "_note": "MALFORMED STUB: reply to /eos/get/cue/99/index/0 on an empty list. Wrong address, no UID. A parser must treat a missing UID as 'absent', not build a record.",
