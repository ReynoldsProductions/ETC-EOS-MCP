      "args": [
        { "type": "s", "value": "ETC Fixtures" },
        { "type": "s", "value": "S4 LED S3 Lustr X8 Direct" },
        { "type": "s", "value": "Intens" }, { "type": "f", "value": 0 }, { "type": "f", "value": 0 }, { "type": "f", "value": 100 },
        { "type": "s", "value": "Red" }, { "type": "f", "value": 0 }, { "type": "f", "value": 0 }, { "type": "f", "value": 100 },
